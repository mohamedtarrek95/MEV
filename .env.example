# Solana mainnet RPC endpoint used for all on-chain reads and transaction sends.
#
# The public endpoint (api.mainnet-beta.solana.com) returns HTTP 403 "Access
# forbidden" for browser requests that carry an Origin header, so it cannot be
# used from this SPA. Set this variable to your own provider, e.g.:
#
#   Helius:    https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#   QuickNode: https://<endpoint>.quiknode.pro/<id>/
#   Alchemy:   https://solana-mainnet.g.alchemy.com/v2/YOUR_KEY
#   Triton:    https://rpc.mainnet-alpha.triton.one
#
# If unset, the app falls back to a public, CORS-friendly RPC
# (https://solana-rpc.publicnode.com) which is fine for testing only.
VITE_SOLANA_RPC_URL=https://solana-rpc.publicnode.com
