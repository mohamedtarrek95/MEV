# Meme Intel - Environment Variables

# Redis URL (recommended for production persistence)
# Get from Upstash: https://upstash.com (free tier: 10k commands/day)
# Format: redis://default:password@host:port
# If not set, API scrapes on every request (still works, just no caching)
REDIS_URL=

# Intel worker refresh interval (ms). Only used by optional worker script.
# Default: 300000 (5 min). The API endpoint scrapes on-demand regardless.
INTEL_REFRESH_MS=300000
