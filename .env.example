# Solana mainnet RPC endpoint used for all on-chain reads, transaction sends
# and confirmation. Read by every Connection via import.meta.env.VITE_SOLANA_RPC_URL.
#
# If unset, the app falls back to the Helius endpoint below.
VITE_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=8f5ecd9c-6e46-42dc-9691-f807e5f89558

# Twitter/X API v2 Bearer Token for meme coin trend research.
# Get one at: https://developer.twitter.com/en/portal/dashboard
# If unset, the app falls back to mock/simulated data.
VITE_TWITTER_BEARER_TOKEN=

# DexScreener API key (optional).
# Get one at: https://dexscreener.com/api
# If unset, unauthenticated requests are used (may hit rate limits).
VITE_DEXSCREENER_API_KEY=

# CoinGecko API key (optional, currently unused but reserved for future expansion).
VITE_COINGECKO_API_KEY=
